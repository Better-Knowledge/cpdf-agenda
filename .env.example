# ── Banco (Supabase em produção; Postgres local no dev) ──────────────────────
# Produção: string do pooler do Supabase (transaction mode) com o usuário do serviço.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agenda
CANAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agenda

# ── Auth ─────────────────────────────────────────────────────────────────────
# Segredo JWT do projeto Supabase (Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=troque-me
# Fase 1 do conector: API keys estáticas mapeadas para org_id (JSON {"chave": "org_uuid"}).
AGENT_API_KEYS={}
# Credencial service-to-service que o agenda-service usa para falar com o canal-service.
CANAL_SERVICE_KEY=troque-me

# ── Integrações (vazio = integração desligada) ───────────────────────────────
TASKS_SERVICE_URL=
TASKS_SERVICE_KEY=
CRM_SERVICE_URL=
CRM_SERVICE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CALENDLY_WEBHOOK_SECRET=

# ── Canal ────────────────────────────────────────────────────────────────────
CANAL_SERVICE_URL=http://canal-service:8000
# Chave Fernet para cifrar credenciais de driver no banco (gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CANAL_CRYPTO_KEY=troque-me

# ── Agente / orquestrador do inbound (IA-04) ─────────────────────────────────
# Para onde o canal encaminha a mensagem já normalizada. Vazio = o canal só
# registra o inbound (o humano vê a conversa, ninguém responde automático).
ORQUESTRADOR_URL=http://agente-service:8000/inbound
ORQUESTRADOR_KEY=troque-me
# A mesma chave, do lado de quem recebe.
AGENTE_SERVICE_KEY=troque-me
# Credencial com que o agente chama a agenda (ator=agente: cancelar continua
# exigindo confirmação humana).
AGENDA_SERVICE_URL=http://agenda-service:8000
AGENDA_SERVICE_KEY=troque-me
# Classificação de intenção. Sem chave, o agente usa só as regras
# determinísticas — o que não bate vai para o humano.
ANTHROPIC_API_KEY=
MODELO=claude-haiku-4-5-20251001

# ── Comportamento ────────────────────────────────────────────────────────────
APP_ENV=dev            # dev|prod — em dev, X-Org-Id é aceito como auth
LOG_LEVEL=INFO
