# ── Banco (Supabase em produção; Postgres local no dev) ──────────────────────
# Produção: string do pooler do Supabase (transaction mode) com o usuário do serviço.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agenda
CANAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agenda

# ── Auth ─────────────────────────────────────────────────────────────────────
# Segredo JWT do projeto Supabase (Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=troque-me
# Credenciais de agente NÃO ficam aqui: vivem em `agent_credentials`, com escopo
# por credencial e revogação sem redeploy. Emita a primeira da organização com
#   make credencial ORG=<uuid> NOME="Painel" PAPEL=administrativo
# e as demais pela tela de Integrações (T-11).
#
# Credencial service-to-service que o agenda-service usa para falar com o canal-service.
CANAL_SERVICE_KEY=troque-me

# ── Integrações (vazio = integração desligada) ───────────────────────────────
TASKS_SERVICE_URL=
TASKS_SERVICE_KEY=
CRM_SERVICE_URL=
CRM_SERVICE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CALENDLY_WEBHOOK_SECRET=

# ── Canal ────────────────────────────────────────────────────────────────────
CANAL_SERVICE_URL=http://canal-service:8000
# Driver self-host (Evolution) chama o webhook pela rede interna do Docker...
WEBHOOK_BASE_URL=http://canal-service:8000
# ...driver de nuvem (Telegram, Z-API) precisa de HTTPS público. Exponha SÓ o
# caminho /webhooks/canal/ — o resto do canal continua fechado.
WEBHOOK_BASE_URL_PUBLICA=
# Chave Fernet para cifrar credenciais de driver no banco (gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CANAL_CRYPTO_KEY=troque-me

# ── Agente / orquestrador do inbound (IA-04) ─────────────────────────────────
# Para onde o canal encaminha a mensagem já normalizada. Vazio = o canal só
# registra o inbound (o humano vê a conversa, ninguém responde automático).
ORQUESTRADOR_URL=http://agente-service:8000/inbound
ORQUESTRADOR_KEY=troque-me
# A mesma chave, do lado de quem recebe.
AGENTE_SERVICE_KEY=troque-me
# Credencial LEGADA com que o agente chamava a agenda pela organização inteira.
# Desde o RF-19 ele usa o token de sessão cunhado pelo canal, e com
# ATENDIMENTO_ISOLADO ligado (o padrão) esta chave não abre nada na agenda.
# Só continua servindo ao rollback.
AGENDA_SERVICE_URL=http://agenda-service:8000
AGENDA_SERVICE_KEY=troque-me
# Classificação de intenção. Sem chave, o agente usa só as regras
# determinísticas — o que não bate vai para o humano.
ANTHROPIC_API_KEY=
MODELO=claude-haiku-4-5-20251001

# ── Isolamento do atendimento (RF-19) ────────────────────────────────────────
# Segredo do token de sessão de atendimento. O canal cunha, a agenda valida —
# então o valor tem de ser O MESMO nos dois serviços. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio em produção derruba a emissão de propósito: sem ele, o token seria
# assinado com um segredo público e qualquer um poderia falar por qualquer
# cliente. Não reuse SUPABASE_JWT_SECRET.
SESSAO_ATENDIMENTO_SECRET=troque-me
# Já vem LIGADO no código: X-Service-Key não concede mais a organização
# inteira, e todo atendimento passa pelo token de sessão. Deixe assim.
# ATENDIMENTO_ISOLADO=0 é rollback deliberado, para um deploy que dê errado —
# e devolve a um único segredo de ambiente o poder sobre todos os clientes.

# ── Conector MCP administrativo (PRD §14.5) ──────────────────────────────────
# Ele NÃO tem credencial própria de propósito: repassa o `Authorization` de
# quem chamou. Se um dia aparecer uma chave de serviço aqui, o conector virou
# um deputado confuso — e a separação de papéis inteira caiu num arquivo .env.
# Domínios (Host) aceitos pelo transporte MCP — proteção contra DNS rebinding.
# Sem isto, em produção o serviço NÃO sobe: com a proteção ligada e a lista
# vazia o SDK recusaria toda requisição, o que pareceria falha de rede.
MCP_HOSTS_PERMITIDOS=["mcp.SEU-DOMINIO.com"]

# ── Comportamento ────────────────────────────────────────────────────────────
APP_ENV=dev            # dev|prod — em dev, X-Org-Id é aceito como auth
LOG_LEVEL=INFO
