# Substitua pelos seus domínios. TLS automático via Let's Encrypt.
agenda.SEU-DOMINIO.com {
	# UI (SPA) em /app; todo o resto é a API
	handle /app* {
		reverse_proxy web:80
	}
	handle {
		reverse_proxy agenda-service:8000
	}
}

# Conectores MCP do programa. O caminho carrega o módulo e o papel, para que
# os módulos 03 e 04 publiquem os deles no mesmo host sem colidir.
# O cliente MCP aponta para https://mcp.SEU-DOMINIO.com/agenda/admin/mcp
mcp.SEU-DOMINIO.com {
	handle_path /agenda/admin/* {
		reverse_proxy agenda-admin-mcp:8000
	}
	# Atendimento: https://mcp.SEU-DOMINIO.com/agenda/mcp
	# A ordem importa — /agenda/admin/* é mais específico e casa primeiro.
	handle_path /agenda/* {
		reverse_proxy agenda-mcp:8000
	}
	handle {
		respond "conector desconhecido" 404
	}
}

# O canal-service NÃO é exposto ao público — só os webhooks inbound dos drivers.
# Qualquer outra rota do canal é service-to-service dentro da rede do compose.
canal.SEU-DOMINIO.com {
	@webhooks path /webhooks/canal/* /health
	handle @webhooks {
		reverse_proxy canal-service:8000
	}
	handle {
		respond "não exposto" 403
	}
}
